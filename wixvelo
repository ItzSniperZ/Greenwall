import { ok, serverError } from 'wix-http-functions';
import wixData from 'wix-data';

export async function post_sensorData(request) {
  try {
    const body = await request.body.json();
    const items = [];

    for (const section of body) {
      for (const cell of section.cells || []) {
        if (cell.moist === -1) continue;
        items.push({
          timestamp:     new Date(),
          sectionNumber: section.board_id,
          cellNumber:    cell.cell,
          temperature:   cell.temp,
          humidity:      cell.hum,
          moisture:      cell.moist,
        });
      }
    }

    await Promise.all(items.map(item =>
      wixData.insert('SensorReadings', item)
    ));

    return ok({ headers: { "Content-Type": "application/json" }, body: { success: true, count: items.length } });
  } catch (e) {
    return serverError({ headers: { "Content-Type": "application/json" }, body: { error: e.message } });
  }
}

export async function post_wateringLog(request) {
  try {
    const body = await request.body.json();

    await wixData.insert('WateringLog', {
      timestamp: new Date(body.timestamp),
      boardId:   body.board_id,
      cell:      body.cell,
      reason:    body.reason,
    });

    return ok({ headers: { "Content-Type": "application/json" }, body: { success: true } });
  } catch (e) {
    return serverError({ headers: { "Content-Type": "application/json" }, body: { error: e.message } });
  }
}
